<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1220">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Переводчик (вместо Azure/Aliyun)" android:textColor="#8BA4D9" android:textStyle="bold" />
        <RadioGroup android:id="@+id/trGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/trAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Авто: словарь → Google → Zen → MyMemory" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trDict" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Локальный словарь / ONNX-фразы (офлайн)" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trGoogle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Google Translate (без ключа)" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trDeepl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DeepL online (с запасным каналом)" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trMem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MyMemory" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trZen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OpenCode Zen free (без ключа)" android:textColor="#E8EEF8" />
            <RadioButton android:id="@+id/trOr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OpenRouter :free (ключ опционально)" android:textColor="#E8EEF8" />
        </RadioGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Модель Zen / GGUF-класс (облако)" android:textColor="#8BA4D9" />
        <Spinner android:id="@+id/zenModel" android:layout_width="match_parent" android:layout_height="48dp" android:background="#162033" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="OpenRouter API key (не обязателен)" android:textColor="#8BA4D9" />
        <EditText android:id="@+id/orKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="sk-or-…" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#64748B" />
    </LinearLayout>
</ScrollView>
