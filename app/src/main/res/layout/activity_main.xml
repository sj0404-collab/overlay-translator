<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overlay OCR Translator"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Плавающий оверлей: выделите область экрана, OCR распознает текст, перевод и озвучка в реальном времени."
            android:textColor="#A8B3C7"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Язык исходника"
            android:textColor="#8BA4D9" />

        <Spinner
            android:id="@+id/srcLang"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#162033"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Язык перевода / голос"
            android:textColor="#8BA4D9" />

        <Spinner
            android:id="@+id/dstLang"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#162033"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/liveMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Live-режим (повторный OCR каждые ~1.2с)"
            android:textColor="#E8EEF8" />

        <CheckBox
            android:id="@+id/speakMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Озвучивать перевод (TTS)"
            android:textColor="#E8EEF8" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5B8DEF"
            android:text="Разрешить оверлей"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3D6BD4"
            android:text="Разрешить захват экрана"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#22C55E"
            android:text="Запустить оверлей"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#334155"
            android:text="Остановить"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Статус: ожидание разрешений"
            android:textColor="#94A3B8" />
    </LinearLayout>
</ScrollView>
