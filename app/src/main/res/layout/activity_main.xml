<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#08111E">

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:background="#0C1626">

        <Button
            android:id="@+id/tabFrame"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Рамка"
            android:textColor="#EAF2FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabSite"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Сайт"
            android:textColor="#8EA6C8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screenFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/tsxWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/tsxFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Не удалось загрузить локальный интерфейс"
                android:textColor="#EAF2FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="Встроенный TSX-интерфейс не запустился. Нажмите «Повторить» или переустановите APK."
                android:textColor="#A8B8D2"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tsxRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:backgroundTint="#A6C1FF"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="26dp"
                android:paddingVertical="12dp"
                android:text="Повторить"
                android:textColor="#06172B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/screenSite"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#0C1626">

            <EditText
                android:id="@+id/urlField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textUri"
                android:hint="https://… или поисковый запрос"
                android:textColorHint="#5E759B"
                android:textColor="#EAF2FF"
                android:background="@android:drawable/editbox_background"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:autofillHints="url" />

            <Button
                android:id="@+id/goBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Открыть"
                android:textColor="#06172B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#A6C1FF" />
        </LinearLayout>

        <WebView
            android:id="@+id/siteWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>