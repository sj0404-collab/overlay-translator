<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Локальный русский OCR"
            android:textColor="#8BA4D9"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Встроенные PP-OCR-модели обрабатывают только выбранный фрагмент на устройстве. Снимок экрана не отправляется в сеть."
            android:textColor="#E8EEF8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Рамка сканирования"
            android:textColor="#8BA4D9"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="В оверлее нажмите «Рамка», обведите именно страницу или облачко, затем нажмите «Скан». Верхняя строка системы, нижняя навигация и элементы оверлея вне рамки не попадут в OCR."
            android:textColor="#94A3B8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Озвучивание"
            android:textColor="#8BA4D9"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Кнопка «Озвучить» использует выбранный системный русский голос. При отсутствии русского голоса установите любой совместимый TTS-движок в настройках Android."
            android:textColor="#94A3B8" />
    </LinearLayout>
</ScrollView>
